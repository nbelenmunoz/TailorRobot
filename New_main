writeline(t_robot,pos_j); data=CONTROL(t_robot);disp(data);
%Teach np to the robots
writeline(t_robot,num2str(np)); data=CONTROL(t_robot);disp(data);
%LOOP DI TEACH Pstart, REALTIME,TAGLIO,ALZO FEED
clc;
sub_n=1;
for n=1:np
    %Teach P_start e P_end to the robot
    if mod(n, 2) == 1
        data=TEACH_P(t_robot,PPstr(sub_n,1));disp(data);
    else
        data=TEACH_P(t_robot,PPstr(sub_n,2));disp(data);
    end
    %robots move to P1
    data=CONTROL(t_robot);disp(data);
    %REALTIME_IN
    writeline(t_robot,num2str(1));
    data=CONTROL(t_robot);disp(data);
    %PREPARO FILE CONFIG
    fullpath = fullfile(pathconf, confname);
    fid = fopen(fullpath, 'w');
    if fid == -1
        error('Impossibile aprire o creare il file: %s', fullpath);
    end
    if mod(n, 2) == 1
        txt=nomi_matrici+"_"+num2str(sub_n)+"_1.txt";% numero dispari
    else
        txt=nomi_matrici+"_"+num2str(sub_n)+"_2.txt";% numero pari
        sub_n=sub_n+1;
    end
    fprintf(fid, '# IP  filename        cycle_time timeout\n');
    temp=IP_robot(1)+' ./Traiettorie/FP/FPmat/'+txt+' 7100 7100';
    fprintf(fid,"%s",temp);
    fclose(fid);
