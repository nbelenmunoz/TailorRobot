%% IMPORT START POINTS FROM TXT FILES
%Percorso dei file txt
cartella_madre="C:\Users\CYBORG\Desktop\REALTIME_TASTIERA_FP\Mitsubishi-RT-main\Mitsubishi-RT-main\x64\Release\Traiettorie\FP\";
nomi_txt="FPreal";
cartella_mat=cartella_madre+"FPmat\"; nomi_matrici="FPmat";
giunti=1;
n_subtxt=1;%numero di tracce singole all'interno di una cartella (nella cartella vedo nome_1.txt,nome_2.txt etc.)
np=n_subtxt*2;%numero finale di punti che è 2 volte i subtxt perchè ho il cut in mezzo
%Calcello i txt temporanei di FPmat
if isfolder(cartella_mat)
    files_txt = dir(fullfile(cartella_mat, "*.txt"));
    
    for k = 1:length(files_txt)
        delete(fullfile(cartella_mat, files_txt(k).name));
    end
else
    mkdir(cartella_mat);
end
% Importo tutti i txt e salvo i punti iniziali,cut e finali dei TXT
P_start=zeros(n_subtxt,7);P_cut=P_start;P_end=P_start;
vel=10;sample_time=0.007;tratto_aftercut=40;%mm/s,s,mm
cut_index=ceil(tratto_aftercut/(vel*sample_time));%vado a end-cut-index per scegliere il punto in cui salvare
for i=1:n_subtxt
    %txt_temp=table2array(readtable(cartella_madre+nomi_txt+"_"+num2str(i),'delimiter',' '));
    opts = detectImportOptions(cartella_madre + nomi_txt + "_" + num2str(i));
    T = readtable(cartella_madre + nomi_txt + "_" + num2str(i), opts);
    txt_temp = table2array(T);
    P_start(i,1:length(txt_temp(1,:)))=txt_temp(1,:);
    P_cut(i,1:length(txt_temp(1,:)))=txt_temp(end-cut_index,:);
    P_end(i,1:length(txt_temp(1,:)))=txt_temp(end,:);
    M1=txt_temp(1:end-cut_index,:); M2=txt_temp(end-cut_index:end,:);
    writematrix(M1, cartella_mat+ nomi_matrici + "_" + num2str(i) +'_1.txt', 'Delimiter', ' ');
    writematrix(M2, cartella_mat + nomi_matrici + "_" + num2str(i) +'_2.txt', 'Delimiter', ' ');
end
clear txt_temp;%libero spazio

%% CONVERTO NUMERI IN STRINGHE PER TEACH

