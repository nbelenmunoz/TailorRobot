if giunti==1
    robot_flag="";
end
%CONVERTO A STRINGHE CORRETTE PER IL TEACHING
for i=1:n_subtxt
     PPstr(i,1)=genP(P_start(i,1:6),robot_flag); %stringa inizi robot
     PPstr(i,2)=genP(P_cut(i,1:6),robot_flag); %stringa fini robot
     PPstr(i,3)=genP(P_end(i,1:6),robot_flag); %stringa fini robot
end
clc;
disp("VAI NEL PROGRAMMA MITSU E AVVIALO");
