    if motors==1 || umotors==1
        if mod(n, 2) == 1
            writeline(t_umotor,strcat("1\n"));%numero dispari ->taglio
        else
            writeline(t_umotor,strcat("0\n"));%numero pari ->nontaglio
        end
    end
    pause(pausa(1));
    %FINISCO DI DEPOSITARE
    writeline(t_robot,num2str(0));%se dico 1 va avanti a depositare in linea retta, altrimento no
    data=CONTROL(t_robot);disp(data);
    %ALZO IL ROBOT
    pause(pausa(2));
    if mod(n, 2) == 1
         writeline(t_robot,num2str(0));%numero dispari ->non alzo
    else
        writeline(t_robot,num2str(1));%numero pari ->alzo
    end
    data=CONTROL(t_robot);disp(data);
    %FEEDING AFTERCUT
    if motors==1 || umotors==1
        if mod(n, 2) == 1
            writeline(t_umotor,strcat("G0\n"));%numero dispari ->non feed
        else
            writeline(t_umotor,strcat("G",num2str(ang_feed),"\n"));%numero pari ->feed
        end
    end
    pause(pausa(3));
    %TORNO A CASA SE HO FINITO TUTTO
    if n==np
        writeline(t_robot,num2str(1));
    else
        writeline(t_robot,num2str(0));
    end
    data=CONTROL(t_robot);disp(data);
