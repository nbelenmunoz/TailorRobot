    cmd = sprintf('cd /d "%s" && ProvaMistu2.exe %s %s %s %s %s %s',path,confname,pos_j,tastiera,sec_sottoprocessi,msec_attesa, " ");
    %HERE YOU CAN START THE ARDUINO
    system(cmd);%HERE IT OPENS CMC AND START THE C++ CODE
    %REALTIME_OUT
    data=CONTROL(t_robot);disp(data);
