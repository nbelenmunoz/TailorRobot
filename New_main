ang_feed=0;%numero di gradi che rotea il motore di feed aftercut, 1000 va bene
pausa=[3,1,3];%array delle pause di processo per taglio etc.
path="C:\Users\CYBORG\Desktop\REALTIME_TASTIERA_FP\Mitsubishi-RT-main\Mitsubishi-RT-main\x64\Release";
pathconf = "C:\Users\CYBORG\Desktop\REALTIME_TASTIERA_FP\Mitsubishi-RT-main\Mitsubishi-RT-main\x64\Release\configs";
